{
    "name": "dealnews/metadata",
    "description": "Extracts meta data (using oembed, opengraph, twitter-cards, scrapping the html, etc) from web pages",
    "type": "library",
    "license": "BSD-3-Clause",
    "autoload": {
        "psr-4": {
            "DealNews\\Metadata\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.1",
        "ext-dom": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
